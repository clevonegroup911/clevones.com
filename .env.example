# Names only. Never put a real secret in this file.
# Inventory, locations, and Secret Manager target: docs/SECRETS.md

# PostgreSQL connection string (required).
# Replace USER, PASSWORD, host, port, and database name locally.
# Never commit a real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clevones?schema=public"

# HMAC secret for signed admin session tokens (required).
# Generate a value with: openssl rand -base64 48
# Minimum 32 characters. Never commit the real secret.
AUTH_SECRET=""

# Optional. Absolute admin session lifetime in seconds.
# Default: 28800 (8 hours)
# AUTH_SESSION_TTL_SECONDS="28800"

# Canonical public origin for absolute admin redirects in middleware.
# Required in production. Must be https in production.
# Never derived from Host or X-Forwarded-* headers.
APP_ORIGIN="https://clevones.com"

# AES-256-GCM key for MFA secrets at rest.
# Exactly 32 bytes, base64-encoded. Generate with: openssl rand -base64 32
# Required in production. Never commit the real key.
MFA_ENCRYPTION_KEY=""

# TOTP issuer label shown in authenticator apps.
MFA_ISSUER="CLEVONES"

# Dedicated PostgreSQL URL for `npm run test:mfa:postgres` only.
# Must target a loopback or ephemeral test database whose name contains
# test, tmp, mfa, or t00. Never set this to a production database.
# Leave empty in normal environments. Never fall back to DATABASE_URL.
TEST_DATABASE_URL=""

# Optional alias for TEST_DATABASE_URL (MFA postgres tests only).
# MFA_TEST_DATABASE_URL=""

# Optional Playwright database URL. Loopback/ephemeral test DB only.
# PLAYWRIGHT_DATABASE_URL=""

# Optional. Explicit owner flag required to create an admin in production.
# Not a secret. Leave unset.
# ALLOW_ADMIN_CREATE_IN_PRODUCTION=""

# X200 Control Center local mutations (T045). Default false.
# When true on a compatible local Fedora host, SUPER_ADMIN may start/stop/restart
# the user systemd AUTOPILOT unit or run one safe cycle via fixed execFile argv.
# Never commit the value true. Never enable on remote production.
X200_CONTROL_ACTIONS_ENABLED=false

# X200 Human Action Center (T046). Default false.
# Enables SUPER_ADMIN gated human actions (approvals, merge preview, etc.).
# Production-impacting adapters still require X200_PRODUCTION_ACTIONS_ENABLED.
X200_HUMAN_ACTIONS_ENABLED=false

# Production deploy/migrate/restore adapters. Default false.
# Even when true, production adapters still require X200_PRODUCTION_ACTIONS_ENABLED.
# X200_FORCE_MERGE_ADAPTER_MOCK=true forces MOCK mode (mutations disabled; never live SUCCESS).
# process.env.CI alone must never fake a successful MARK_READY / merge human action.
X200_PRODUCTION_ACTIONS_ENABLED=false

# Development-only CSRF allow-list (comma-separated). localhost / 127.0.0.1 only.
# Ignored when NODE_ENV=production. Never use wildcards.
# Example: http://localhost:3000,http://localhost:3001
X200_LOCAL_ALLOWED_ORIGINS=

# Dev/test only: accept mock MFA codes for privileged action challenges.
# Never enable in production.
# X200_PRIVILEGED_MFA_MOCK=false

# Email provider mode for operational notifications (T023).
# Allowed values for now: console | test | memory
# Real SMTP/API providers require secrets outside Git (human gate).
EMAIL_PROVIDER="console"
