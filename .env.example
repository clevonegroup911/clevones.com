# PostgreSQL connection string (required).
# Replace USER, PASSWORD, host, port, and database name locally.
# Never commit a real connection string.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/clevones?schema=public"

# HMAC secret for signed admin session tokens (required).
# Generate a value with: openssl rand -base64 48
# Minimum 32 characters. Never commit the real secret.
AUTH_SECRET=""

# Optional. Absolute admin session lifetime in seconds.
# Default: 28800 (8 hours)
# AUTH_SESSION_TTL_SECONDS="28800"

# Canonical public origin for absolute admin redirects in middleware.
# Required in production. Must be https in production.
# Never derived from Host or X-Forwarded-* headers.
APP_ORIGIN="https://clevones.com"
